# Front door for the whole system on one port (plain HTTP; Cloudflare Tunnel provides HTTPS).
#   /telegram/webhook  -> bot      (public; the bot checks Telegram's secret token)
#   /api/bot/*         -> blocked  (bot -> API calls stay on the internal Docker network)
#   everything else    -> password -> Style Vault app, /api, /media
{
	auto_https off
}

:80 {
	encode zstd gzip

	handle /telegram/webhook {
		reverse_proxy bot:3000
	}

	handle /api/bot/* {
		respond 404
	}

	handle {
		basic_auth {
			{$APP_USER} {$APP_PASSWORD_HASH}
		}

		handle /api/* {
			request_body {
				max_size 200MB
			}
			reverse_proxy api:{$API_PORT:8000}
		}

		handle /media/* {
			reverse_proxy api:{$API_PORT:8000}
		}

		handle /health {
			reverse_proxy api:{$API_PORT:8000}
		}

		handle {
			root * /srv
			@static path /assets/*
			header @static Cache-Control "public, max-age=31536000, immutable"
			header /sw.js Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
