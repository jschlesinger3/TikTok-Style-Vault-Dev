# Copy to .env and fill in. Never commit .env.

# ---- API ----
API_PORT=8000
# If set, all /api requests must send header X-API-Key. Generate: openssl rand -hex 24
API_KEY=
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# ---- PostgreSQL (docker-compose db container) ----
POSTGRES_USER=vault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vault
# Used when running the API outside compose, or against a managed DB (compose overrides it for the bundled db):
DATABASE_URL=postgresql://vault:change-me@localhost:5432/vault

# ---- S3-compatible object storage ----
# DigitalOcean Spaces: https://<region>.digitaloceanspaces.com | Linode: https://<region>.linodeobjects.com
# AWS S3 / Lightsail buckets: leave S3_ENDPOINT_URL empty
S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_BUCKET=my-style-vault
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public/CDN base used to build image URLs (optional; falls back to endpoint/bucket/key)
S3_PUBLIC_BASE_URL=
MAX_UPLOAD_MB=10

# ---- Drop scraper ----
# 0 disables the periodic background loop
SCRAPER_INTERVAL_MINUTES=30
SCRAPER_TIMEOUT_SECONDS=20
# JS-rendered pages: set both to true (image grows ~400MB)
SCRAPER_USE_PLAYWRIGHT=false
INSTALL_PLAYWRIGHT=false
