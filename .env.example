# Wardrobe system configuration. Easiest: run ./setup.sh, which writes this file for you.
# Otherwise copy to .env and fill in. Never commit .env.
# Values containing $ (the password hash) must be in 'single quotes'.

# ============ Required ============

# Claude (console.anthropic.com > API Keys) - used by Style Vault's photo/video/link analysis.
# n8n uses the same key in its "Anthropic" Header Auth credential for /fit and /audit.
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Random string Telegram echoes on every webhook call. Generate: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Your Telegram chat id. The bot serves nobody until this is set: message it once and it replies with your id.
ALLOWED_CHAT_IDS=
# Shared secret on bot -> Style Vault and bot -> n8n calls (header X-Bot-Secret). Generate: openssl rand -hex 24
# In n8n, set the same value in each Webhook node's Header Auth credential.
BOT_SHARED_SECRET=

# Database (compose builds DATABASE_URL for the api service from these)
POSTGRES_USER=wardrobe
POSTGRES_PASSWORD=
POSTGRES_DB=wardrobe
# Connection string for anything outside the compose network (n8n on the Mac, psql):
DATABASE_URL=postgresql://wardrobe:CHANGE_ME@localhost:5432/wardrobe

# Style Vault login (the web app + /api are behind this password; the Telegram webhook is not)
APP_USER=me
# Generate: docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'your-password'
APP_PASSWORD_HASH=''

# The public https address your Cloudflare Tunnel routes to http://localhost:8080 (or web:80).
# Used to register the Telegram webhook and for "Open in Style Vault" links.
PUBLIC_URL=https://style.example.com

# ============ Networking / ports ============

# Local port Caddy listens on (Cloudflare Tunnel target)
WEB_PORT=8080
API_PORT=8000
DB_PORT=5432
# Where n8n is reachable from the bot container:
#   n8n running on the Mac (outside this compose): http://host.docker.internal:5678
#   bundled n8n (COMPOSE_PROFILES includes n8n):   http://n8n:5678
N8N_BASE_URL=http://host.docker.internal:5678
# Optional services: tunnel = run cloudflared in compose, n8n = run n8n in compose. Comma-separated.
COMPOSE_PROFILES=
# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > token (only for the tunnel profile)
CLOUDFLARE_TUNNEL_TOKEN=
TZ=America/New_York

# ============ Media storage ============

# local = files on this machine (Docker volume "media", served at /media). s3 = S3-compatible bucket.
STORAGE_BACKEND=local
# Cloudflare's free plan rejects request bodies over 100 MB, so keep videos under that through the tunnel.
MAX_VIDEO_MB=95
MAX_IMAGE_MB=15
STORE_VIDEOS=true
# Only for STORAGE_BACKEND=s3:
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# ============ Analysis / scraper (defaults are fine) ============

ANALYSIS_MODEL=claude-sonnet-5-5
ANALYSIS_FRAMES=6
SCRAPER_INTERVAL_MINUTES=30
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_USE_PLAYWRIGHT=false
INSTALL_PLAYWRIGHT=false
# Optional extra X-API-Key check on /api (normally leave empty; the web password protects the API)
API_KEY=
CORS_ORIGINS=http://localhost:5173
