# Easiest: run ./setup.sh, which writes .env for you. Or copy to .env and fill in. Never commit .env.
# Values containing $ (the password hash) must be in 'single quotes'.

# ---- Web front door (Caddy) ----
# Your domain, or <server-ip-with-dashes>.sslip.io (free, no DNS needed), e.g. 203-0-113-7.sslip.io
DOMAIN=
APP_USER=me
# Generate: docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'your-password'
APP_PASSWORD_HASH=''

# ---- API ----
API_PORT=8000
# Optional extra header check (X-API-Key). Leave empty when using the Caddy password (recommended).
API_KEY=
# Comma-separated frontend origins allowed by CORS (only matters for local dev on another port)
CORS_ORIGINS=http://localhost:5173

# ---- PostgreSQL (docker-compose db container) ----
POSTGRES_USER=vault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vault
# Used when running the API outside compose, or against a managed DB (compose overrides it for the bundled db):
DATABASE_URL=postgresql://vault:change-me@localhost:5432/vault

# ---- S3-compatible object storage ----
# DigitalOcean Spaces: https://<region>.digitaloceanspaces.com | Linode: https://<region>.linodeobjects.com
# AWS S3 / Lightsail buckets: leave S3_ENDPOINT_URL empty
S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_BUCKET=my-style-vault
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Public/CDN base used to build image URLs (optional; falls back to endpoint/bucket/key)
S3_PUBLIC_BASE_URL=
MAX_IMAGE_MB=15
MAX_VIDEO_MB=150
# Keep original videos in the bucket so they play in the vault (false = only store a cover frame)
STORE_VIDEOS=true

# ---- AI piece identification (Claude vision) ----
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-opus-5-5
# Frames sampled per video (more = better coverage, higher cost)
ANALYSIS_FRAMES=6

# ---- Drop scraper ----
# 0 disables the periodic background loop
SCRAPER_INTERVAL_MINUTES=30
SCRAPER_TIMEOUT_SECONDS=20
# JS-rendered pages: set both to true (image grows ~400MB)
SCRAPER_USE_PLAYWRIGHT=false
INSTALL_PLAYWRIGHT=false
