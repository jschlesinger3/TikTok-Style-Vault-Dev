# Copy to .env and fill in.

# From @BotFather
TELEGRAM_BOT_TOKEN=
# Random string Telegram sends back on every webhook call. Generate: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Your Telegram chat id. The bot serves nobody until this is set: message it once and it replies with your id.
# Comma-separate for more people.
ALLOWED_CHAT_IDS=

# Public address for the Telegram webhook. No domain? Use <server-ip-with-dashes>.sslip.io
DOMAIN=

# Sent to n8n as header X-Bot-Secret; set the same value in each n8n Webhook node (Header Auth).
N8N_SHARED_SECRET=

POSTGRES_PASSWORD=
TZ=America/New_York

# Only needed when running server.js outside docker-compose (compose sets these for you):
# N8N_INGEST_URL=http://localhost:5678/webhook/wardrobe-ingest
# N8N_INSPO_URL=http://localhost:5678/webhook/wardrobe-inspo
# N8N_FIT_URL=http://localhost:5678/webhook/wardrobe-fit
# N8N_WORN_URL=http://localhost:5678/webhook/wardrobe-worn
# N8N_PURGE_URL=http://localhost:5678/webhook/wardrobe-purge
# N8N_AUDIT_URL=http://localhost:5678/webhook/wardrobe-audit
# PORT=3000
